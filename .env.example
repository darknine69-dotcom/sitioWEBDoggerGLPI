# ==============================================================
# Dogger HelpDesk — variables de entorno (multi-hosting)
# Copia este archivo a .env y ajusta los valores.
# Compatible con: Render, Railway, Fly.io, VPS con Docker, bare metal.
# ==============================================================

# --- Seguridad (OBLIGATORIO en producción) ---
# Genera una con: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# false en producción
DJANGO_DEBUG=False

# Dominios permitidos (separados por coma). Ej: tusitio.com,www.tusitio.com
# Con el dominio mal puesto, Django responde "DisallowedHost" en cada request.
DJANGO_ALLOWED_HOSTS=tusitio.com,www.tusitio.com

# Orígenes que el navegador usa para los POST (CSRF). Debe coincidir con el
# esquema real (https:// en producción): si no, cada formulario da 403.
DJANGO_CSRF_TRUSTED_ORIGINS=https://tusitio.com,https://www.tusitio.com

# SSL: true si Django debe redirigir a HTTPS. Ponlo en false si tu proxy
# (Nginx/Caddy/LoadBalancer) ya fuerza HTTPS.
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_ENABLE_HSTS=False

# Cookies de sesión y CSRF "secure" (solo aplican con DJANGO_DEBUG=False).
# Déjalas en true con HTTPS. Bájalas a false SOLO si publicas por HTTP sin
# TLS (túnel, red interna): con true el navegador no guarda el cookie de
# sesión y nadie puede iniciar sesión.
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True

# --- Base de datos ---
# PostgreSQL (Recomendado en producción). Cualquier hosting crea una URL así:
# DATABASE_URL=postgres://user:pass@host:5432/dbname
DATABASE_URL=

# (Alternativa local) SQL Server
# DB_NAME=Tickets
# DB_USER=DGT
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=1433
# DB_DRIVER=ODBC Driver 18 for SQL Server
# DB_EXTRA_PARAMS=TrustServerCertificate=yes

# --- Media (archivos subidos) ---
# En Docker/VPS apunta a un volumen persistente (ej: /app/media).
# En Render/Railway usa un Disk montado; en Fly.io un mount.
DJANGO_MEDIA_ROOT=/app/media
DJANGO_MEDIA_URL=/media/

# --- Dogger ---
DOGGER_CORREO=sistemasbogota@dogger.com.co
DOGGER_WHATSAPP=3103716129

# --- SMTP (Office365) — envío de notificaciones de tickets ---
# Recomendado: usa una contraseña de aplicación de Office365.
# Genera una en: https://account.activedirectory.microsoft.com/AppPasswords
EMAIL_HOST=smtp.office365.com
EMAIL_PORT=587
EMAIL_USER=aprendizsistemasmed@dogger.com.co
EMAIL_PASSWORD=contraseña-o-app-password
EMAIL_USE_TLS=True
EMAIL_FROM=aprendizsistemasmed@dogger.com.co

# --- GLPI (solo LAN; desactivado en la nube) ---
GLPI_ENABLED=False
GLPI_BASE_URL=http://glpi.dogger.local/apirest.php
GLPI_APP_TOKEN=
GLPI_USER_TOKEN=
GLPI_TIMEOUT=4
GLPI_WEBHOOK_SECRET=

# --- Seeds (usuario inicial; define password seguro en producción) ---
SEED_ADMIN_EMAIL=soporte@dogger.com.co
SEED_ADMIN_NOMBRE=Ricardo Blandon
SEED_ADMIN_PASSWORD=
SEED_USUARIO_EMAIL=jeralcom@gmail.com
SEED_USUARIO_NOMBRE=Jeral Com
SEED_USUARIO_PASSWORD=

# --- Gunicorn (opcional) ---
GUNICORN_WORKERS=2
